{
  "layer": "top",              // keeps the bar above windows
  "position": "top",
  "modules-left": [
    "sway/workspaces",         // 🏢 Workspaces (left side)
    "sway/language",           // 🌐 Keyboard layout/language
    "network"                  // 📶 Wi-Fi block (left side)
  ],
  "modules-right": [
    "pulseaudio",              // 🔊 Volume
    "backlight",               // ☀️ Brightness
    "battery",                 // 🔋
    "clock",                   // 🕒
    "custom/power"             // ⚡ Power menu
  ],

  ////////////////////////////////////////////////////////////////////
  // Module-specific settings
  ////////////////////////////////////////////////////////////////////

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,           // Only show workspaces for current monitor
    "format": "{index}",
    "format-icons": {
      "urgent": "",
      "focused": "",
      "default": ""
    }
  },

  "sway/language": {
    "format": "🌐 {short}",
    "tooltip-format": "Keyboard: {long}",
    "on-click": "swaymsg 'input * xkb_switch_layout next'"
  },

  "network": {
    "interface": "wlp2s0",      // set your Wi-Fi NIC (e.g. wlan0, wlp2s0)
    "family": "ipv4",
    "interval": 3,
    "format-wifi": "📶 {essid} {signalStrength}%",
    "tooltip-format": "{ipaddr}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇 Muted",
    "format-icons": {
      "headphone": "🎧",
      "hands-free": "🎧",
      "headset": "🎧",
      "phone": "📞",
      "portable": "📱",
      "car": "🚗",
      "default": ["🔈", "🔉", "🔊"]
    },
    "scroll-step": 5,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "☀️ {percent}%",
    "scroll-step": 5,
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "cpu": {
    "format": "{usage:2}%   ",
    "interval": 2
  },

  "memory": {
    "format": "{used:0.1f}/{total:0.1f}G  ",
    "interval": 5
  },

  "battery": {
    // Works for most laptops; check `upower -e` for your device path.
    "bat": "BAT0",
    "format": "{icon} {capacity}% ",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "tooltip-format": "{:%A, %d %B %Y}",     // full date on hover
    "format": "{:%a %d %b %H:%M}",           // day date month time (e.g., "Mon 15 Jan 14:30")
    "interval": 60
  },

  "custom/power": {
    "format": "⚡",
    "tooltip": "Power Menu",
    "on-click": "echo -e 'Shutdown\\nReboot\\nSleep\\nLogout' | wofi --dmenu --prompt 'Power Menu' --width 200 --height 200 --cache-file /dev/null | xargs -I {} sh -c 'case {} in Shutdown) systemctl poweroff;; Reboot) systemctl reboot;; Sleep) systemctl suspend;; Logout) swaymsg exit;; esac'"
  }
}

