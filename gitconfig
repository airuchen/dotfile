	email = ywc907@node-robotics.com
[core]
	editor = nvim
[clangFormat]
  binary = clang-format
[alias]
  fmt = clang-format
  lg = log --color --graph --pretty=format:'%C(yellow)%h%Creset -%C(bold blue)%d%Creset %s %C(white)(%cr) %C(green)<%an>%Creset' --abbrev-commit
  lg2 = log --color --graph --pretty=format:'%C(yellow)%h%Creset %C(white)%cd %C(green)<%an>%Creset%C(bold blue)%d%n%C(bold white)%s%n%b' --abbrev-commit
  fixup = !sh -c 'REV=$(git rev-parse $1) && git commit --fixup $@ --no-verify && git rebase -i --autosquash $REV^ && pre-commit run --from-ref $REV --to-ref HEAD' -
[init]
  defaultBranch = main
[rebase]
  autosquash = true
[rerere]
	enabled = true
[column]
  # Columns for UI
	ui = auto
[branch]
  # Sort branches by reverse committer date
	sort = -committerdate
[fetch]
  # Issues for LazyNvim
	writeCommitGraph = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
