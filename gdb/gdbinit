set history save on
set history remove-duplicates 10
set history filename ~/.cache/gdb_history

# from https://gcc.gnu.org/onlinedocs/libstdc++/manual/debug.html: Using gdb
set print pretty on
# Print derived type based on vtable info
set print object on
set print static-members on
set print vtbl on
set print demangle on
set demangle-style auto

# Pretty printers
python
import sys
import os;
cfg_dir = os.path.expanduser("~/.config/gdb")
sys.path.insert(0, cfg_dir)
from printers import register_eigen_printers

# should be loaded by default
# from libstdcxx.v6.printers import register_libstdcxx_printers
# register_libstdcxx_printers(None)

register_eigen_printers(None)
end
